                            <button class="faq-button w-full text-left py-3 px-4 md:p-10 flex items-center justify-between md:block md:text-center md:cursor-pointer" aria-expanded="false">
                                <h3 class="font-syne text-lg md:text-2xl font-bold md:mb-4"><span class="line block">4. Départ de la conception</span></h3>
                                <div class="faq-icon md:hidden text-accent transition-transform duration-300 flex-shrink-0 ml-4">
                                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                    </svg>
                                </div>
                            </button>
                            <div class="faq-content overflow-hidden transition-all duration-300 h-0 opacity-0 md:!h-auto md:!opacity-100 px-4 pb-4 pt-0 md:px-10 md:pb-10 md:pt-0">
                                <p class="font-inter text-gray-600 text-sm leading-relaxed text-left md:text-center"><span class="line block">Une fois les éléments pré-requis reçus, la création du site internet peut débuter. Il faut compter en moyenne un mois avant la livraison.</span></p>
                            </div>
                        </div>
                        <!-- Card 5 -->
                        <div class="bg-white hover:shadow-lg transition-shadow border border-black/5 reveal-text faq-item">
                            <button class="faq-button w-full text-left py-3 px-4 md:p-10 flex items-center justify-between md:block md:text-center md:cursor-pointer" aria-expanded="false">
                                <h3 class="font-syne text-lg md:text-2xl font-bold md:mb-4"><span class="line block">5. Retours et échanges</span></h3>
                                <div class="faq-icon md:hidden text-accent transition-transform duration-300 flex-shrink-0 ml-4">
                                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                    </svg>
                                </div>
                            </button>
                            <div class="faq-content overflow-hidden transition-all duration-300 h-0 opacity-0 md:!h-auto md:!opacity-100 px-4 pb-4 pt-0 md:px-10 md:pb-10 md:pt-0">
                                <p class="font-inter text-gray-600 text-sm leading-relaxed text-left md:text-center"><span class="line block">Tout au long de la création nous échangeons ensemble sur le design du site internet et de possibles modifications à apporter.</span></p>
                            </div>
                        </div>
                        <!-- Card 6 -->
                        <div class="bg-white hover:shadow-lg transition-shadow border border-black/5 reveal-text faq-item">
                            <button class="faq-button w-full text-left py-3 px-4 md:p-10 flex items-center justify-between md:block md:text-center md:cursor-pointer" aria-expanded="false">
                                <h3 class="font-syne text-lg md:text-2xl font-bold md:mb-4"><span class="line block">6. Livraison & Suivi</span></h3>
                                <div class="faq-icon md:hidden text-accent transition-transform duration-300 flex-shrink-0 ml-4">
                                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                    </svg>
                                </div>
                            </button>
                            <div class="faq-content overflow-hidden transition-all duration-300 h-0 opacity-0 md:!h-auto md:!opacity-100 px-4 pb-4 pt-0 md:px-10 md:pb-10 md:pt-0">
                                <p class="font-inter text-gray-600 text-sm leading-relaxed text-left md:text-center"><span class="line block">Après livraison du site internet, il vous appartient ! Un hébergement, une maintenance mensuelle et suivi, vous sont proposés.</span></p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Pensé pour votre métier -->
            <section id="metiers" class="snap-section min-h-[100svh] flex flex-col justify-center py-20 px-6 md:px-12 bg-pitch relative z-10 w-full">
                <div class="container mx-auto max-w-4xl text-center">
                    <div class="reveal-text mb-6">
                        <p class="line font-syne text-3xl md:text-5xl lg:text-6xl font-bold uppercase tracking-tighter text-white">
                            Pensé pour votre métier
                        </p>
                    </div>
                    <div class="reveal-text mb-14 md:mb-20">
                        <p class="line font-serif italic text-gray-400 text-lg md:text-xl font-light">
                            Quel que soit votre domaine, votre site sera taillé sur mesure.
                        </p>
                    </div>
                    <div class="flex flex-wrap justify-center gap-3 md:gap-4">
                        {% set metiers = ["Artisans", "Coiffeurs", "Restaurateurs", "Plombiers", "Électriciens", "Agents immobiliers", "Thérapeutes", "Photographes", "Coachs", "Commerces de proximité"] %}
                        {% for metier in metiers %}
                        <span class="metier-tag font-inter text-xs md:text-sm text-gray-400 border border-white/20 px-4 md:px-6 py-2 md:py-2.5 rounded-full hover:bg-accent hover:text-white hover:border-accent transition-all duration-300 cursor-default">
                            {{ metier }}
                        </span>
                        {% endfor %}
                    </div>
                </div>
            </section>

            <!-- Pricing / Minimalist Brutalism -->
            <section id="forfaits"
                class="snap-section min-h-[100svh] flex flex-col justify-center py-20 px-6 md:px-12 bg-pitch border-t border-white/10 relative z-10 grid-lines overflow-hidden w-full">
                <div class="container mx-auto max-w-7xl">
                    <div
                        class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 md:mb-24 reveal-text">
                        <h2 class="font-syne text-4xl md:text-7xl font-bold uppercase tracking-tighter text-white">
                            <span class="line block">Forfaits</span>
                        </h2>
                        <p class="text-gray-400 font-inter font-light max-w-sm text-left md:text-right mt-6 md:mt-0">
                            <span class="line block">Des solutions claires et transparentes.</span>
                            <span class="line block">Tarifs de lancement, sans surprise.</span>
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-y border-white/20">

                        {% for plan in pricing %}
                        <div class="group border-b md:border-b-0 md:border-r border-white/20 p-8 md:p-10 lg:p-16 {% if plan.badge %}hover:bg-accent text-white hover:text-white{% else %}hover:bg-surface{% endif %} transition-colors cursor-hover magnetic-area"
                            data-magnetic-strength="5">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-syne text-xl md:text-2xl font-bold {% if not plan.badge %}text-white{% endif %} uppercase">{{ plan.name }}{% if plan.badge %} <span
                                        class="text-[9px] md:text-[10px] ml-2 px-2 py-1 border border-current rounded-full">{{ plan.badge }}</span>{% endif %}
                                </h3>
                                <div class="w-3 h-3 rounded-full {% if plan.badge %}bg-white group-hover:bg-white{% else %}border border-white/30 group-hover:bg-accent group-hover:border-accent{% endif %} transition-colors"></div>
                            </div>
                            {% if plan.tagline %}<p class="font-inter text-xs text-accent mb-12 md:mb-16">{{ plan.tagline }}</p>{% else %}<div class="mb-12 md:mb-16"></div>{% endif %}
                            <div class="mb-12 md:mb-16">
                                <p class="text-xs md:text-sm font-inter {% if plan.badge %}opacity-60{% else %}text-gray-400{% endif %} uppercase tracking-widest mb-4">À
                                    partir de</p>
                                <p
                                    class="font-syne text-5xl md:text-6xl font-bold {% if not plan.badge %}text-white{% endif %} tracking-tighter {% if not plan.badge %}group-hover:text-accent{% endif %} transition-colors">
                                    {{ plan.price }}<span class="text-2xl md:text-3xl">€</span></p>
                                <p class="mt-4 font-serif italic {% if plan.badge %}opacity-70{% else %}text-gray-500{% endif %}">{{ plan.price_subtitle }}</p>
                            </div>
                            <ul class="font-inter text-sm {% if plan.badge %}opacity-90{% else %}text-gray-400{% endif %} space-y-4">
                                {% for feature in plan.features %}
                                <li class="flex items-center gap-3"><span
                                        class="w-1 h-1 bg-{% if plan.badge %}current{% else %}white{% endif %} rounded-full"></span>
                                    <span class="{% if 'Tout' in feature %}text-accent font-semibold{% endif %}">{{ feature }}</span></li>
                                {% endfor %}
                            </ul>
                        </div>
                        {% endfor %}

                        <!-- Colonne Sur-mesure / E-commerce -->
                        <div class="group p-8 md:p-10 lg:p-16 hover:bg-surface transition-colors cursor-hover magnetic-area" data-magnetic-strength="5">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-syne text-xl md:text-2xl font-bold text-white uppercase">E-commerce</h3>
                                <div class="w-3 h-3 rounded-full border border-accent/50 group-hover:bg-accent group-hover:border-accent transition-colors"></div>
                            </div>
                            <p class="font-inter text-xs text-accent mb-12 md:mb-16">Pour vendre vos produits en ligne</p>
                            <div class="mb-12 md:mb-16">
                                <p class="text-xs md:text-sm font-inter text-gray-400 uppercase tracking-widest mb-4">Uniquement</p>
                                <p class="font-syne text-5xl md:text-6xl font-bold text-white tracking-tighter group-hover:text-accent transition-colors">Sur devis<span class="text-2xl md:text-3xl"></span></p>
                                <p class="mt-4 font-serif italic text-gray-500">Boutique Shopify</p>
                            </div>
                            <ul class="font-inter text-sm text-gray-400 space-y-4 mb-10">
                                <li class="flex items-center gap-3"><span class="w-1 h-1 bg-white rounded-full"></span>Boutique e-commerce Shopify</li>
                                <li class="flex items-center gap-3"><span class="w-1 h-1 bg-white rounded-full"></span>Périmètre & fonctionnalités libres</li>
                                <li class="flex items-center gap-3"><span class="w-1 h-1 bg-white rounded-full"></span>Intégrations sur-mesure</li>
                                <li class="flex items-center gap-3"><span class="w-1 h-1 bg-white rounded-full"></span>Premier échange offert</li>
                            </ul>
                            <a href="/e-commerce/" class="inline-flex items-center gap-2 text-xs font-inter uppercase tracking-widest text-accent hover:text-white transition-colors cursor-hover">
                                Voir l'offre e-commerce
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                </svg>
                            </a>
                        </div>

                    </div>

                    <!-- CTA Buttons -->
                    <div class="mt-16 md:mt-24 flex flex-col md:flex-row justify-center items-center gap-6">
                        <a href="/services/"
                            class="group relative inline-flex items-center justify-center px-8 py-[1.25rem] border border-white/20 text-xs md:text-sm font-syne uppercase tracking-wider text-white overflow-hidden rounded-full cursor-hover magnetic hover:border-accent transition-colors duration-500"
                            data-magnetic-strength="50">
                            <span
                                class="relative z-10 transition-colors group-hover:text-black font-bold text-center flex items-center gap-3">
                                Voir en détail les offres et services
                            </span>
                            <div
                                class="absolute inset-0 bg-accent translate-y-[101%] group-hover:translate-y-[0%] transition-transform duration-500 ease-out z-0">
                            </div>
                        </a>
                        <a href="/contact/" class="btn-magnetic cursor-hover magnetic" data-magnetic-strength="50">
                            <span class="relative z-10 flex items-center gap-3">
                                DEMANDER UN AUDIT GRATUIT
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                    stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                </svg>
                            </span>
                        </a>

                    </div>
                </div>

                <!-- Decorative vertical text -->
                <div
                    class="absolute top-64 right-12 hidden md:flex items-center gap-4 origin-right rotate-90 opacity-20 text-white pointer-events-none">
                    <span class="text-[1.2rem] uppercase font-bold tracking-[0.4em]">Services</span>
                    <div class="w-16 h-[1px] bg-white"></div>
                </div>
            </section>
