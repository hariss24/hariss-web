            <!-- Services en bref -->
            <section class="py-24 md:py-32 px-6 md:px-12 bg-pitch text-white relative z-20 w-full border-b border-white/10">
                <div class="container mx-auto max-w-6xl">
                    <div class="text-center mb-16 md:mb-20">
                        <p class="text-xs font-bold uppercase tracking-[0.3em] font-inter text-accent mb-4">( CE QUE JE FAIS POUR VOUS )</p>
                        <h2 class="font-syne text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter">
                            Mes <span class="font-serif italic font-normal text-accent normal-case">services</span>
                        </h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <a href="/services/" class="group border border-white/10 p-8 md:p-10 hover:border-accent/50 transition-colors cursor-hover">
                            <div class="w-14 h-14 border border-accent/30 bg-accent/5 flex items-center justify-center mb-6 text-accent group-hover:bg-accent group-hover:text-white transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
                                </svg>
                            </div>
                            <h3 class="font-syne text-xl md:text-2xl font-bold mb-3 uppercase tracking-tight">Création de site web</h3>
                            <p class="font-inter text-gray-400 text-sm leading-relaxed">Un site professionnel qui vous ressemble, visible sur mobile et ordinateur, que vous pouvez modifier vous-même.</p>
                        </a>
                        <a href="/services/" class="group border border-white/10 p-8 md:p-10 hover:border-accent/50 transition-colors cursor-hover">
                            <div class="w-14 h-14 border border-accent/30 bg-accent/5 flex items-center justify-center mb-6 text-accent group-hover:bg-accent group-hover:text-white transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                                </svg>
                            </div>
                            <h3 class="font-syne text-xl md:text-2xl font-bold mb-3 uppercase tracking-tight">Visibilité sur Google</h3>
                            <p class="font-inter text-gray-400 text-sm leading-relaxed">Votre site apparaît dans les résultats de recherche locaux. Vos futurs clients vous trouvent facilement.</p>
                        </a>
                        <a href="/services/" class="group border border-white/10 p-8 md:p-10 hover:border-accent/50 transition-colors cursor-hover">
                            <div class="w-14 h-14 border border-accent/30 bg-accent/5 flex items-center justify-center mb-6 text-accent group-hover:bg-accent group-hover:text-white transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.1 3.04.97-5.66L3.2 8.58l5.68-.83L11.42 2.8l2.54 4.95 5.68.83-4.09 3.97.97 5.66z" />
                                </svg>
                            </div>
                            <h3 class="font-syne text-xl md:text-2xl font-bold mb-3 uppercase tracking-tight">Suivi & évolutions</h3>
                            <p class="font-inter text-gray-400 text-sm leading-relaxed">Votre site évolue avec vous. Mises à jour, nouvelles pages, assistance technique : je reste disponible.</p>
                        </a>
                    </div>
                    <div class="text-center mt-12">
                        <a href="/services/"
                            class="group relative inline-flex items-center justify-center px-8 py-[1.25rem] border border-white/20 text-xs md:text-sm font-syne uppercase tracking-wider text-white overflow-hidden rounded-full cursor-hover magnetic hover:border-accent transition-colors duration-500"
                            data-magnetic-strength="50">
                            <span class="relative z-10 transition-colors group-hover:text-black font-bold flex items-center gap-3">
                                Découvrir tous les services
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                </svg>
                            </span>
                            <div class="absolute inset-0 bg-accent translate-y-[101%] group-hover:translate-y-[0%] transition-transform duration-500 ease-out z-0"></div>
                        </a>
                    </div>
                </div>
            </section>

            <!-- Scrollytelling Methodology (Replaces Portfolio) -->
            <section id="methodology-scroll" class="relative w-full bg-pitch text-white" style="height: 300vh;">
                <!-- Sticky Container -->
                <div class="sticky top-0 h-screen w-full flex items-center overflow-hidden">

                    <!-- Progress Bar (Desktop only, minimal) -->
                    <div
                        class="absolute top-1/2 left-6 md:left-12 transform -translate-y-1/2 w-[2px] h-32 bg-white/10 z-30 hidden md:block">
                        <div id="method-progress"
                            class="w-full bg-accent absolute top-0 left-0 transition-none will-change-[height]"
                            style="height: 0%;"></div>
                    </div>

                    <!-- Track container (Full width to allow horizontal shift) -->
                    <div id="method-track" class="w-max h-full flex items-center will-change-transform"
                        style="transform: translate3d(0,0,0);">

                        {% for step in methodology_steps %}
                        <!-- Step {{ loop.index }} -->
                        <div
                            class="w-screen h-full flex-shrink-0 flex items-center justify-center method-step px-6 md:px-24 {% if not loop.first %}opacity-20{% endif %}">
                            <div class="max-w-3xl w-full method-content transform {% if not loop.first %}scale-[0.8]{% endif %} transition-transform duration-300">
                                <p
                                    class="font-syne text-accent text-xl md:text-2xl mb-4 md:mb-6 uppercase tracking-widest font-bold">
                                    {{ step.number }}. {{ step.label }}</p>
                                <h3
                                    class="font-syne text-4xl md:text-6xl lg:text-7xl font-bold uppercase tracking-tighter mb-6 md:mb-8 leading-none">
                                    {{ step.title_main }} <br><span
                                        class="font-serif italic text-white/50 lowercase tracking-normal">{{ step.title_italic }}</span>
                                </h3>
                                <p
                                    class="font-inter text-base md:text-xl text-gray-400 font-light max-w-xl leading-relaxed">
                                    {{ step.description }}
                                </p>
                            </div>
                        </div>
                        {% endfor %}

                    </div>
                </div>
            </section>

            <!-- Pensé pour votre métier -->
            <section class="pt-10 md:pt-16 pb-24 md:pb-32 px-6 md:px-12 bg-pitch relative z-10 w-full">
                <div class="container mx-auto max-w-4xl text-center">
                    <div class="reveal-text mb-6">
                        <p class="line font-syne text-3xl md:text-5xl lg:text-6xl font-bold uppercase tracking-tighter text-white">
                            Pensé pour votre métier
                        </p>
                    </div>
                    <div class="reveal-text mb-14 md:mb-20">
                        <p class="line font-serif italic text-gray-400 text-lg md:text-xl font-light">
                            Quel que soit votre domaine, votre site sera taillé sur mesure.
                        </p>
                    </div>
                    <div class="flex flex-wrap justify-center gap-3 md:gap-4">
                        {% set metiers = ["Artisans", "Coiffeurs", "Restaurateurs", "Plombiers", "Électriciens", "Agents immobiliers", "Thérapeutes", "Photographes", "Coachs", "Commerces de proximité"] %}
                        {% for metier in metiers %}
                        <span class="metier-tag font-inter text-xs md:text-sm text-gray-400 border border-white/20 px-4 md:px-6 py-2 md:py-2.5 rounded-full hover:bg-accent hover:text-white hover:border-accent transition-all duration-300 cursor-default">
                            {{ metier }}
                        </span>
                        {% endfor %}
                    </div>
                </div>
            </section>

            <!-- Pricing / Minimalist Brutalism -->
            <section
                class="py-32 md:py-40 px-6 md:px-12 bg-pitch border-t border-white/10 relative z-10 grid-lines overflow-hidden w-full">
                <div class="container mx-auto max-w-7xl">
                    <div
                        class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 md:mb-24 reveal-text">
                        <h2 class="font-syne text-4xl md:text-7xl font-bold uppercase tracking-tighter text-white">
                            <span class="line block">Forfaits</span>
                        </h2>
                        <p class="text-gray-400 font-inter font-light max-w-sm text-left md:text-right mt-6 md:mt-0">
                            <span class="line block">Des solutions claires et transparentes.</span>
                            <span class="line block">Tarifs de lancement, sans surprise.</span>
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-y border-white/20">

                        {% for plan in pricing %}
                        <div class="group border-b md:border-b-0 md:border-r border-white/20 p-8 md:p-10 lg:p-16 {% if plan.badge %}hover:bg-accent text-white hover:text-white{% else %}hover:bg-surface{% endif %} transition-colors cursor-hover magnetic-area"
                            data-magnetic-strength="5">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-syne text-xl md:text-2xl font-bold {% if not plan.badge %}text-white{% endif %} uppercase">{{ plan.name }}{% if plan.badge %} <span
                                        class="text-[9px] md:text-[10px] ml-2 px-2 py-1 border border-current rounded-full">{{ plan.badge }}</span>{% endif %}
                                </h3>
                                <div class="w-3 h-3 rounded-full {% if plan.badge %}bg-white group-hover:bg-white{% else %}border border-white/30 group-hover:bg-accent group-hover:border-accent{% endif %} transition-colors"></div>
                            </div>
                            {% if plan.tagline %}<p class="font-inter text-xs text-accent mb-12 md:mb-16">{{ plan.tagline }}</p>{% else %}<div class="mb-12 md:mb-16"></div>{% endif %}
                            <div class="mb-12 md:mb-16">
                                <p class="text-xs md:text-sm font-inter {% if plan.badge %}opacity-60{% else %}text-gray-400{% endif %} uppercase tracking-widest mb-4">À
                                    partir de</p>
                                <p
                                    class="font-syne text-5xl md:text-6xl font-bold {% if not plan.badge %}text-white{% endif %} tracking-tighter {% if not plan.badge %}group-hover:text-accent{% endif %} transition-colors">
                                    {{ plan.price }}<span class="text-2xl md:text-3xl">€</span></p>
                                <p class="mt-4 font-serif italic {% if plan.badge %}opacity-70{% else %}text-gray-500{% endif %}">{{ plan.price_subtitle }}</p>
                            </div>
                            <ul class="font-inter text-sm {% if plan.badge %}opacity-90{% else %}text-gray-400{% endif %} space-y-4">
                                {% for feature in plan.features %}
                                <li class="flex items-center gap-3"><span
                                        class="w-1 h-1 bg-{% if plan.badge %}current{% else %}white{% endif %} rounded-full"></span>
                                    <span class="{% if 'Tout' in feature %}text-accent font-semibold{% endif %}">{{ feature }}</span></li>
                                {% endfor %}
                            </ul>
                        </div>
