<!-- Header -->
<header id="main-header"
    class="fixed top-0 w-full z-50 py-5 px-6 md:px-12 bg-pitch/80 backdrop-blur-xl border-b border-white/5 flex justify-between items-center transition-transform duration-500 ease-in-out">
    <a href="/" class="flex items-center gap-3 cursor-hover magnetic" data-magnetic-strength="20">
        <span class="font-syne font-bold text-xl tracking-tighter text-white">H<span class="text-accent">.</span></span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center space-x-10">
        <a href="#hero" class="text-xs uppercase tracking-[0.2em] font-medium text-white hover:text-accent transition-colors cursor-hover">Home</a>
        <a href="#about" class="text-xs uppercase tracking-[0.2em] font-medium text-white hover:text-accent transition-colors cursor-hover">A Propos</a>
        <a href="#experience" class="text-xs uppercase tracking-[0.2em] font-medium text-white hover:text-accent transition-colors cursor-hover">Experience & Services</a>
        <a href="#blog" class="text-xs uppercase tracking-[0.2em] font-medium text-white hover:text-accent transition-colors cursor-hover">Blog</a>
        <a href="#contact" class="text-xs uppercase tracking-[0.2em] font-medium text-white hover:text-accent transition-colors cursor-hover">Contact</a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button id="mobile-menu-btn" class="md:hidden text-white cursor-hover magnetic" data-magnetic-strength="30"
        aria-label="Ouvrir le menu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
    </button>
</header>

<!-- Mobile Nav -->
<div id="mobile-menu"
    class="hidden md:hidden fixed top-0 left-0 w-full h-[100svh] bg-pitch/95 backdrop-blur-3xl z-40 flex flex-col justify-center items-center opacity-0 transition-opacity duration-500">
    <nav class="flex flex-col items-center space-y-8">
        <a href="#hero" class="text-2xl font-syne uppercase tracking-tighter font-bold text-white hover:text-accent transition-colors menu-link">Home</a>
        <a href="#about" class="text-2xl font-syne uppercase tracking-tighter font-bold text-gray-400 hover:text-accent transition-colors menu-link">A Propos</a>
        <a href="#experience" class="text-2xl font-syne uppercase tracking-tighter font-bold text-gray-400 hover:text-accent transition-colors menu-link">Experience</a>
        <a href="#blog" class="text-2xl font-syne uppercase tracking-tighter font-bold text-gray-400 hover:text-accent transition-colors menu-link">Blog</a>
        <a href="#contact" class="text-2xl font-syne uppercase tracking-tighter font-bold text-gray-400 hover:text-accent transition-colors menu-link">Contact</a>
    </nav>
</div>
