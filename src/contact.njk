<!-- Page Header -->
<section class="py-20 lg:py-24 text-center relative grid-lines overflow-hidden w-full">
    <div class="container mx-auto px-4 relative z-10">
        <h1
            class="font-syne text-4xl md:text-6xl lg:text-7xl font-extrabold text-white leading-tight mb-6 uppercase tracking-tighter">
            {{ page_title }} <span class="text-gradient">{{ page_title_accent }}</span>
        </h1>
        <p class="font-inter text-lg md:text-xl text-gray-400 max-w-2xl mx-auto">
            {{ page_description }}
        </p>
    </div>

    <!-- Decorative vertical text -->
    <div
        class="absolute bottom-12 right-12 hidden md:flex items-center gap-4 origin-right rotate-90 opacity-20 text-white">
        <span class="text-[1.2rem] uppercase font-bold tracking-[0.4em]">Disponible</span>
        <div class="w-16 h-[1px] bg-white"></div>
    </div>
</section>

<!-- Form Section -->
