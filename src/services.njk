                                        class="text-[9px] md:text-[10px] ml-2 px-2 py-1 border border-current rounded-full">{{ plan.badge }}</span>{% endif %}
                                </h3>
                                <div class="{{ 'w-3 h-3 rounded-full bg-white group-hover:bg-white transition-colors' if plan.hover_style == 'accent' else 'w-3 h-3 rounded-full border border-white/30 group-hover:bg-accent group-hover:border-accent transition-colors' }}"></div>
                            </div>
                            {% if plan.tagline %}<p class="font-inter text-xs text-accent {% if plan.hover_style == 'accent' %}group-hover:text-white/70 transition-colors{% endif %} mb-12 md:mb-16">{{ plan.tagline }}</p>{% else %}<div class="mb-12 md:mb-16"></div>{% endif %}
