  - name: Pro
    badge: POPULAIRE
    price: '990'
    subtitle: "Site Vitrine (jusqu'à 5 pages)"
    tagline: Pour un site complet et autonome
    hover_style: accent
    categories:
      - cat_name: Pages & Design
        items:
          - text: Tout l'offre Essentiel inclus
            type: inclus
