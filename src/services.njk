<!-- Page Header -->
            <section id="sv-header" class="snap-section min-h-[100svh] flex flex-col justify-center pt-24 pb-6 md:pt-28 md:pb-8 lg:pt-32 lg:pb-10 text-center relative grid-lines overflow-hidden w-full">
                <div class="container mx-auto px-4 relative z-10">
                    <h1
                        class="font-syne text-5xl md:text-6xl lg:text-7xl font-extrabold text-white leading-tight mb-6 uppercase tracking-tighter">
                        {{ page_title }} <span class="font-serif italic font-normal text-accent normal-case">{{ page_title_accent }}</span>
                    </h1>
                    <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto">
                        {{ page_description }}
                    </p>
                </div>

                <!-- Decorative vertical text -->
                <div
                    class="absolute top-[100%] right-12 hidden md:flex items-center gap-4 origin-right rotate-90 opacity-20 text-white">
                    <span class="text-[1.2rem] uppercase font-bold tracking-[0.4em]">Solutions</span>
                    <div class="w-16 h-[1px] bg-white"></div>
                </div>
            </section>

            {% set service_icons = [
                '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>',
                '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>',
                '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.1 3.04.97-5.66L3.2 8.58l5.68-.83L11.42 2.8l2.54 4.95 5.68.83-4.09 3.97.97 5.66z" /></svg>'
            ] %}

            {% for service in services_list %}
            <!-- Service {{ loop.index }} -->
            <section id="sv-service{{ loop.index }}" class="snap-section min-h-[100svh] flex flex-col justify-center py-16 lg:py-24">
                <div class="container mx-auto px-4 md:px-8 max-w-6xl">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                        <div class="{% if loop.index is odd %}order-2 lg:order-1{% else %}order-2{% endif %} flex flex-col justify-center">
                            <div class="w-16 h-16 border border-accent/30 bg-accent/5 flex items-center justify-center mb-6 text-accent">
                                {{ service_icons[loop.index0] | safe }}
                            </div>
                            <h2 class="font-syne text-3xl md:text-5xl font-bold tracking-tighter uppercase text-white mb-6">
                                {{ service.title }}</h2>
                            <p class="text-gray-300 text-lg mb-6 leading-relaxed">
                                {{ service.description }}
                            </p>
                            <ul class="space-y-4 text-gray-400 mb-8">
                                {% for feature in service.features %}
                                <li class="flex items-start gap-3"><svg class="w-6 h-6 text-accent mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg> {{ feature }}</li>
                                {% endfor %}
                            </ul>
                            <a href="/contact/" class="btn-magnetic cursor-hover magnetic" data-magnetic-strength="20">
                                <span class="relative z-10 flex items-center gap-3">
                                    {{ service.cta_text }}
                                </span>
                            </a>
                        </div>
                        <div class="{% if loop.index is odd %}order-1 lg:order-2{% else %}order-1{% endif %}">
                            <div class="bg-surface border border-white/10 w-full aspect-[4/3] flex items-center justify-center relative overflow-hidden group hover:border-accent/50 transition-colors duration-500 cursor-hover">
                                <img src="{{ service.image }}" alt="{{ service.image_alt }}"
                                    class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500">
                                <div class="absolute inset-0 bg-gradient-to-br from-accent/10 to-transparent opacity-50 group-hover:opacity-100 transition-opacity duration-500 mix-blend-overlay"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            {% endfor %}

            <!-- Pricing Detailed Grid -->
            <section
                class="snap-section min-h-[100svh] py-24 lg:py-32 bg-pitch grid-lines overflow-hidden relative z-10 border-t border-white/10 w-full"
                id="sv-tarifs">
                <div class="container mx-auto max-w-7xl">
                    <div class="text-center mb-16 md:mb-24">
                        <h2 class="font-syne text-4xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6">
                            Forfaits & <span class="text-gradient">Prestations</span>
                        </h2>
                        <p class="text-gray-400 font-inter text-lg max-w-2xl mx-auto">
                            Des tarifs de lancement clairs et transparents, sans surprise. Choisissez le forfait adapté à vos besoins.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 border-y border-white/20">
                        {% for plan in pricing_plans %}
                        <div class="group {{ 'border-b lg:border-b-0 lg:border-r' if not loop.last else '' }} border-white/20 p-8 md:p-10 lg:p-16 hover:bg-{{ plan.hover_style }} transition-colors cursor-hover magnetic-area {{ 'text-white hover:text-white' if plan.hover_style == 'accent' else '' }} flex flex-col"
                            data-magnetic-strength="5">
                            <div class="flex justify-between items-center mb-2">
