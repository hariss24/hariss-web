<section id="ec-demo" class="snap-section relative min-h-[100svh] flex flex-col justify-center py-24 md:py-32 px-3 md:px-12 bg-white text-black overflow-hidden w-full" style="z-index:10000;">
    <div class="container mx-auto max-w-6xl relative z-10">

        <!-- Vidéo client : desktop visible, mobile cachée (tabs) -->
        <div class="reveal-text mb-10" id="video-client-label">
            <p class="font-inter text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">
                <span class="line block">( Ce que le client voit )</span>
            </p>
            <p class="font-inter text-gray-500 font-light text-sm md:text-base">
                <span class="line block">La boutique que vos clients utiliseront au quotidien.</span>
            </p>
        </div>

        <!-- Tabs mobile -->
        <div class="flex md:hidden gap-2 mb-8">
            <button class="video-tab active font-inter text-xs uppercase tracking-widest px-4 py-2 border rounded-full transition-colors duration-300" data-tab="client">Boutique client</button>
            <button class="video-tab font-inter text-xs uppercase tracking-widest px-4 py-2 border rounded-full transition-colors duration-300" data-tab="admin">Interface admin</button>
        </div>

        <!-- Browser mockup vidéo client -->
        <div class="reveal-text w-full border border-black/10 rounded-2xl overflow-hidden shadow-xl video-panel" data-panel="client">
            <div class="flex items-center gap-3 px-5 py-4 bg-black/5 border-b border-black/5">
                <div class="flex gap-1.5">
                    <div class="w-3 h-3 rounded-full bg-black/15"></div>
                    <div class="w-3 h-3 rounded-full bg-black/15"></div>
                    <div class="w-3 h-3 rounded-full bg-black/15"></div>
                </div>
                <div class="flex-1 mx-2 bg-black/5 rounded-md px-4 py-1.5 text-xs text-gray-400 font-mono">demo1-hariss.myshopify.com</div>
                <button class="video-fullscreen-btn md:hidden p-1.5 rounded-md hover:bg-black/10 transition-colors" aria-label="Plein écran">
                    <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5" />
                    </svg>
                </button>
            </div>
            <div style="padding:56.25% 0 0 0;position:relative;">
                <iframe src="https://player.vimeo.com/video/1178161069?autoplay=1&loop=1&muted=1&badge=0&autopause=0&title=0&byline=0&portrait=0&controls=0&player_id=0&app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="Shopify expérience client"></iframe>
                <div style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:1;"></div>
            </div>
        </div>

        <!-- Label vidéo admin (desktop uniquement) -->
        <div class="reveal-text mb-10 mt-20 hidden md:block">
            <p class="font-inter text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">
                <span class="line block">( Ce que vous gérez )</span>
            </p>
            <p class="font-inter text-gray-500 font-light text-sm md:text-base">
                <span class="line block">Une interface simple que vous maîtrisez en quelques heures.</span>
            </p>
        </div>

        <!-- Browser mockup vidéo admin -->
        <div class="reveal-text w-full border border-black/10 rounded-2xl overflow-hidden shadow-xl video-panel hidden md:block" data-panel="admin">
            <div class="flex items-center gap-3 px-5 py-4 bg-black/5 border-b border-black/5">
                <div class="flex gap-1.5">
                    <div class="w-3 h-3 rounded-full bg-black/15"></div>
                    <div class="w-3 h-3 rounded-full bg-black/15"></div>
                    <div class="w-3 h-3 rounded-full bg-black/15"></div>
                </div>
                <div class="flex-1 mx-2 bg-black/5 rounded-md px-4 py-1.5 text-xs text-gray-400 font-mono">admin.shopify.com/store/demo1-hariss</div>
                <button class="video-fullscreen-btn md:hidden p-1.5 rounded-md hover:bg-black/10 transition-colors" aria-label="Plein écran">
                    <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5" />
                    </svg>
                </button>
            </div>
            <div style="padding:56.25% 0 0 0;position:relative;">
                <iframe src="https://player.vimeo.com/video/1178206424?autoplay=1&loop=1&muted=1&badge=0&autopause=0&title=0&byline=0&portrait=0&controls=0&player_id=0&app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="Shopify interface admin"></iframe>
                <div style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:1;"></div>
            </div>
        </div>
        <script src="https://player.vimeo.com/api/player.js"></script>

        <!-- Script tabs mobile + plein écran -->
        <script>
        document.querySelectorAll('.video-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                const target = tab.dataset.tab;
                document.querySelectorAll('.video-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                document.querySelectorAll('.video-panel').forEach(p => {
                    if (p.dataset.panel === target) {
                        p.classList.remove('hidden');
                    } else {
                        p.classList.add('hidden');
                        p.classList.remove('md:block');
                    }
                });
            });
        });

        document.querySelectorAll('.video-fullscreen-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const panel = btn.closest('.video-panel');
                if (panel.requestFullscreen) {
                    panel.requestFullscreen();
                } else if (panel.webkitRequestFullscreen) {
                    panel.webkitRequestFullscreen();
                }
            });
        });
        </script>

    </div>
</section>


